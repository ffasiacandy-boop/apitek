NODE_ENV=development
PORT=4000
# Relative to the project root
DATABASE_URL=./data/database.sqlite
# 32+ random chars in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
# Local development values. Production example: https://api.mytryon.com and https://cdn.mytryon.com
SDK_API_URL=http://localhost:4000
SDK_CDN_URL=http://localhost:4000/cdn
# Set true behind HTTPS (automatic in production)
COOKIE_SECURE=false
# Number of reverse-proxy hops (e.g. 1 behind nginx) so rate limiting sees real IPs
TRUST_PROXY=
ALLOW_REGISTRATION=true
# Seeds license VT-DEMO-0001 for localhost (ignored in production)
SEED_DEMO=true
